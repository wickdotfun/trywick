# Copy to .dev.vars for local development (never committed).
# Lift the per-IP launch limit (every local visitor shares the same IP)
DEV_NO_IP_LIMIT=
# A faster Solana RPC than the public one (Helius, Triton, QuickNode…)
# SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=...
# A short breath to see buybacks come quickly (here: 1 minute, 15 s per match)
# CYCLE_MINUTES=1
# MATCH_MINUTES=0.25
# Share of the $WICK supply per candle (default 0.5)
# CANDLE_PCT=0.5
# Buyback (never with a real wallet locally)
# TOKEN_MINT=
# BUYBACK_SECRET_KEY=
# BURN_WALLET=              (the address of that test key; empty = any)
# LAUNCH_FEE_SOL=0.02
# TEAM_FEE_BPS=5000         (team share of the Ignition Fee, 5000 = 50%)
# TEAM_WALLET=              (default: the dev wallet)
# Creator fee sharing: Ignition Fee with sharing, burn and team parts (basis points, 500 = 5%)
# LAUNCH_FEE_SHARED_SOL=0.01
# SHARE_BURN_BPS=500
# SHARE_TEAM_BPS=500
# Admin page (/admin)
# ADMIN_KEY=a-long-random-password
# Telegram bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@yourchannel
